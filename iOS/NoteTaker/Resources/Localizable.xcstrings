    "Sync checks for changes every 30 seconds while active and after local edits. Failed transfers retry automatically.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱이 활성화된 동안 약 30초마다, 그리고 변경 사항을 저장한 후 자동 동기화합니다. 전송에 실패하면 자동으로 재시도합니다."
          }
        }
      }
    },
    "Sync key copied": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동기화 키가 복사됨"
          }
        }
      }
    },
    "Sync needs attention in Settings": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정에서 동기화 상태를 확인하세요"
          }
        }
      }
    },
    "Sync runs when you open the app, save changes, or choose Sync Now. If both devices edit the same note, the edit with the later device timestamp wins. Keep device clocks set automatically.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱을 열거나 변경 사항을 저장하거나 지금 동기화를 누르면 동기화합니다. 같은 노트를 두 기기에서 수정하면 기기 시간 기준으로 나중에 수정한 내용이 적용됩니다. 기기의 날짜와 시간을 자동 설정으로 유지하세요."
          }
        }
      }
    },
    "Synced": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동기화 완료"
          }
        }
      }
    },
    "Syncing…": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동기화 중…"
          }
        }
      }
    },
    "System Audio": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 오디오"
          }
        }
      }
    },
    "System Gain": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 게인"
          }
        }
      }
    },
    "System Only": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템만"
          }
        }
      }
    },
    "Test": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결 확인"
          }
        }
      }
    },
    "Test Connection": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결 테스트"
          }
        }
      }
    },
    "That recording is no longer available.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해당 녹음 항목을 더 이상 사용할 수 없습니다."
          }
        }
      }
    },
    "The Worker uses D1 for note information and R2 for audio. Set up these resources with the deployment guide included in this project.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Worker는 노트 정보를 D1에, 음성 파일을 R2에 저장합니다. 프로젝트에 포함된 배포 안내에 따라 리소스를 설정하세요."
          }
        }
      }
    },
    "The change could not be saved. The original recording was preserved.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변경 사항을 저장할 수 없어 원본 녹음 항목을 유지했습니다."
          }
        }
      }
    },
    "The existing minutes remain available while this runs.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "처리 중에도 이전 회의록을 볼 수 있습니다."
          }
        }
      }
    },
    "The existing minutes remain available while this runs. Keep this app open until generation finishes.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "생성 중에도 기존 회의록을 볼 수 있습니다. 완료될 때까지 앱을 열어두세요."
          }
        }
      }
    },
    "The previous minutes stay visible while new minutes are generated.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 회의록을 생성하는 동안 이전 회의록은 그대로 볼 수 있습니다."
          }
        }
      }
    },
    "The recording could not be permanently deleted. Its files were preserved.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹음 항목을 영구 삭제할 수 없어 파일을 유지했습니다."
          }
        }
      }
    },
    "The recording could not be removed from this Mac. Its local files were preserved.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹음을 이 Mac에서 제거하지 못했습니다. 로컬 파일은 보존되었습니다."
          }
        }
      }
    },
    "This recording is in Recently Deleted. Restore it to listen again.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최근 삭제된 녹음입니다. 복원하면 다시 들을 수 있습니다."
          }
        }
      }
    },
    "This removes the recording file and metadata. This action cannot be undone.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹음 파일과 메타데이터가 삭제되며 되돌릴 수 없습니다."
          }
        }
      }
    },
    "This removes this Mac's audio and AI files. Sync metadata stays so other devices keep the cloud deletion state.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac의 오디오와 AI 파일을 제거합니다. 다른 기기에서도 클라우드 삭제 상태가 유지되도록 동기화 메타데이터는 남겨 둡니다."
          }
        }
      }
    },
    "Title": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제목"
          }
        }
