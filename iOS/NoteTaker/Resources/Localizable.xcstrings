          "stringUnit": {
            "state": "translated",
            "value": "음성 노트"
          }
        }
      }
    },
    "Waveform": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파형"
          }
        }
      }
    },
    "Waveform unavailable": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파형을 불러오지 못했습니다"
          }
        }
      }
    },
    "When AI minutes are generated, your recording audio and transcript are sent to OpenRouter and the selected model providers. Provider usage may be billed to your OpenRouter account.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 회의록을 생성하면 녹음 오디오와 전사문이 OpenRouter 및 선택한 모델 제공자에게 전송됩니다. 사용량에 따라 OpenRouter 계정에 요금이 부과될 수 있습니다."
          }
        }
      }
    },
    "Writing minutes": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "회의록 작성 중"
          }
        }
      }
    },
    "Your ideas, ready to listen to.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록한 생각을 다시 들어보세요."
          }
        }
      }
    },
    "Your partial recording file was kept. You can retry finishing or recover it on the next launch.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "부분 녹음 파일이 보관되었습니다. 마무리를 다시 시도하거나 다음 실행 시 복구할 수 있습니다."
          }
        }
      }
    },
    "iOS chooses when background refresh runs. Opening the app always checks for updates immediately.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백그라운드 갱신 시점은 iOS가 결정합니다. 앱을 열면 즉시 새 변경 사항을 확인합니다."
          }
        }
      }
    },
    "An API key is registered on another linked device.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 연결 기기에 API 키가 등록되어 있습니다."
          }
        }
      }
    },
    "AI preferences are synced. Enter an OpenRouter API key on this device to generate meeting notes here.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 설정은 동기화되었습니다. 이 기기에서도 회의록을 생성하려면 OpenRouter API 키를 입력해 주세요."
          }
        }
      }
    },
    "Enter API Key on This Device": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에 API 키 입력"
          }
        }
      }
    },
    "Saving a key keeps the automatic-generation preference synced from your other device.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "API 키를 저장해도 다른 기기에서 동기화된 자동 생성 설정은 유지됩니다."
          }
        }
      }
    },
    "Save an API key on this device to automatically generate minutes for new recordings.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 녹음의 회의록을 자동 생성하려면 이 기기에 API 키를 저장해 주세요."
          }
        }
      }
    },
    "Select a model": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모델 선택"
          }
        }
      }
    },
    "AI models, output language, and automatic-generation preferences sync too. API keys stay on each device.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 모델, 출력 언어, 자동 생성 설정도 동기화합니다. API 키는 각 기기에 보관합니다."
          }
        }
      }
    }
  },
  "version": "1.0"
}
