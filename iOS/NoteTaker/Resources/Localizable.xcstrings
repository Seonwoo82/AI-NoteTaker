          }
        }
      }
    },
    "Try a different title.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 제목으로 검색해 보세요."
          }
        }
      }
    },
    "Unable to Complete Action": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업을 완료할 수 없습니다"
          }
        }
      }
    },
    "Use the same Cloudflare server and sync key on your Mac and iPhone. Your recordings stay available offline.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac과 iPhone에 같은 Cloudflare 서버와 동기화 키를 입력하세요. 오프라인에서도 저장된 녹음을 들을 수 있습니다."
          }
        }
      }
    },
    "View AI Meeting Notes": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 회의록 보기"
          }
        }
      }
    },
    "View Notes": {
      "extractionState": "manual",
