<Window x:Class="NoteTaker.Windows.SettingsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:c="clr-namespace:NoteTaker.Windows.Components"
 Title="AI 설정" Width="640" Height="780" MinWidth="540" MinHeight="630" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
 WindowStyle="None" Style="{StaticResource {x:Type Window}}">
 <WindowChrome.WindowChrome><WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="10" UseAeroCaptionButtons="False" /></WindowChrome.WindowChrome>
 <Border Background="{DynamicResource WindowSurface}" BorderBrush="{DynamicResource Separator}" BorderThickness="1" CornerRadius="10">
 <Grid><Grid.RowDefinitions><RowDefinition Height="44" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
  <Grid Background="{DynamicResource ToolbarSurface}"><c:WindowControls HorizontalAlignment="Left" WindowChrome.IsHitTestVisibleInChrome="True" /><TextBlock Text="AI 회의록" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Grid>
  <ScrollViewer x:Name="SettingsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel Margin="24" MaxWidth="560">
    <StackPanel Orientation="Horizontal"><c:AppleIcon Kind="sparkles" Width="24" Height="24" Margin="0,0,8,0" /><TextBlock Text="AI 회의록" FontSize="22" FontWeight="SemiBold" /></StackPanel>
    <TextBlock Text="음성을 글로 바꾸는 전사와 회의록 정리를 각각 선택합니다." Foreground="{DynamicResource Muted}" Margin="0,6,0,20" />
    <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,16"><StackPanel>
     <TextBlock Text="처리 방법" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,12" />
     <TextBlock Text="음성 전사" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,0,0,5" />
     <ComboBox x:Name="TranscriptionProviderBox" SelectionChanged="Provider_Changed" AutomationProperties.Name="음성 전사 처리 방법"><ComboBoxItem Content="이 PC에서 무료 · Whisper" /><ComboBoxItem Content="클라우드 · OpenRouter" /><ComboBoxItem Content="이 PC에서 무료 · Qwen3-ASR" /></ComboBox>
     <TextBlock Text="회의록 정리" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,12,0,5" />
     <ComboBox x:Name="SummaryProviderBox" SelectionChanged="Provider_Changed" AutomationProperties.Name="회의록 정리 처리 방법"><ComboBoxItem Content="이 PC에서 무료 · Qwen / Ollama" /><ComboBoxItem Content="클라우드 · OpenRouter" /></ComboBox>
    </StackPanel></Border>
    <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,16"><StackPanel>
     <StackPanel Orientation="Horizontal"><c:AppleIcon Kind="info" Width="16" Height="16" Margin="0,0,7,0" /><TextBlock Text="내 데이터가 처리되는 곳" FontSize="13" FontWeight="SemiBold" /></StackPanel>
     <TextBlock x:Name="ProcessingNotice" Foreground="{DynamicResource Muted}" LineHeight="20" Margin="0,9,0,0" />
    </StackPanel></Border>
    <Border x:Name="LocalModelCard" Style="{StaticResource SettingsCard}" Margin="0,0,0,16"><StackPanel>
     <TextBlock Text="무료 로컬 모델" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,12" />
     <TextBlock x:Name="LocalSpeechDescription" Text="Whisper large-v3-turbo · 약 1.62 GB" Foreground="{DynamicResource Muted}" FontSize="11" />
     <ComboBox x:Name="QwenAsrModelBox" Margin="0,9,0,0" Visibility="Collapsed"><ComboBoxItem Content="Qwen3-ASR 1.7B · 약 2.81 GB" /><ComboBoxItem Content="Qwen3-ASR 0.6B · 약 1.18 GB" /></ComboBox>
     <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,8,0"><TextBlock Text="전사 언어" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,0,0,5" /><ComboBox x:Name="SpeechLanguageBox"><ComboBoxItem Content="한국어" /><ComboBoxItem Content="자동 감지" /><ComboBoxItem Content="English" /></ComboBox></StackPanel>
      <CheckBox Grid.Column="1" x:Name="UseGpuBox" Content="GPU 사용 (실패 시 CPU)" VerticalAlignment="Bottom" Margin="8,0,0,7" />
     </Grid>
     <TextBlock Text="로컬 회의록 모델" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,14,0,5" /><ComboBox x:Name="LocalSummaryBox"><ComboBoxItem Content="Qwen3.5 4B · 약 3.4 GB" /><ComboBoxItem Content="Qwen3.5 9B · 약 6.6 GB" /></ComboBox>
     <TextBlock Text="로컬 보완 모델" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,14,0,5" /><ComboBox x:Name="LocalEnhancementBox" AutomationProperties.Name="로컬 회의록 보완 모델"><ComboBoxItem Content="회의록 모델과 같게" /><ComboBoxItem Content="Qwen3.5 4B" /><ComboBoxItem Content="Qwen3.5 9B" /></ComboBox>
     <TextBlock Text="Ollama 주소" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,14,0,5" /><TextBox x:Name="OllamaAddressBox" />
     <TextBlock Text="처음 한 번 모델을 다운로드합니다. Ollama가 없으면 실행 환경(약 1.47 GB)도 준비합니다. 다음 실행부터 설치된 모델을 사용합니다." FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,12,0,0" />
     <WrapPanel Margin="0,12,0,0"><Button x:Name="PrepareLocalButton" Content="선택한 로컬 모델 준비" Click="PrepareLocal_Click" Margin="0,0,8,0" /><Button x:Name="CancelPreparationButton" Content="다운로드 중단" Click="CancelPreparation_Click" Visibility="Collapsed" /></WrapPanel>
     <TextBlock x:Name="PreparationStatus" FontSize="11" Foreground="{DynamicResource Accent}" Margin="0,10,0,0" />
    </StackPanel></Border>
    <Border x:Name="CloudKeyCard" Style="{StaticResource SettingsCard}" Margin="0,0,0,16"><StackPanel>
     <Grid><StackPanel Orientation="Horizontal"><c:AppleIcon Kind="key" Width="16" Height="16" Margin="0,0,7,0" /><TextBlock Text="OpenRouter API 키" FontWeight="SemiBold" FontSize="13" /></StackPanel><Border Background="{DynamicResource SegmentSurface}" CornerRadius="9" Padding="7,2" HorizontalAlignment="Right"><TextBlock x:Name="KeyStatus" Text="미설정" FontSize="10" Foreground="{DynamicResource Muted}" /></Border></Grid>
     <PasswordBox x:Name="ApiKeyBox" Margin="0,13,0,0" AutomationProperties.Name="새로운 OpenRouter API 키" />
     <TextBlock x:Name="KeyHint" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,8,0,12" />
     <CheckBox x:Name="DeleteKeyBox" Content="저장된 API 키 삭제" />
    </StackPanel></Border>
    <Border x:Name="CloudModelCard" Style="{StaticResource SettingsCard}" Margin="0,0,0,16"><StackPanel>
     <TextBlock Text="모델" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,13" />
     <Button x:Name="RefreshModelsButton" Content="모델 목록 새로고침" Click="RefreshModels_Click" HorizontalAlignment="Left" Margin="0,0,0,9" /><TextBlock x:Name="CatalogStatus" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,14" />
     <TextBlock Text="회의록 모델 검색" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,0,0,5" /><TextBox x:Name="SummarySearchBox" TextChanged="CatalogSearch_Changed" AutomationProperties.Name="회의록 모델 검색" /><ComboBox x:Name="SummaryModelList" DisplayMemberPath="Label" SelectionChanged="CatalogSelection_Changed" Margin="0,5,0,5" AutomationProperties.Name="회의록 모델 목록" /><TextBox x:Name="SummaryModelBox" TextChanged="CatalogModelId_Changed" AutomationProperties.Name="회의록 모델 ID" /><TextBlock x:Name="SummaryModelDetail" FontSize="11" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,5,0,0" />
     <TextBlock Text="보완 모델 검색 · ID를 비우면 회의록 모델 사용" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,15,0,5" /><TextBox x:Name="EnhancementSearchBox" TextChanged="CatalogSearch_Changed" AutomationProperties.Name="보완 모델 검색" /><ComboBox x:Name="EnhancementModelList" DisplayMemberPath="Label" SelectionChanged="CatalogSelection_Changed" Margin="0,5,0,5" AutomationProperties.Name="보완 모델 목록" /><TextBox x:Name="EnhancementModelBox" TextChanged="CatalogModelId_Changed" AutomationProperties.Name="보완 모델 ID" /><TextBlock x:Name="EnhancementModelDetail" FontSize="11" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,5,0,0" />
     <TextBlock Text="음성 인식 모델 검색" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,15,0,5" /><TextBox x:Name="TranscriptionSearchBox" TextChanged="CatalogSearch_Changed" AutomationProperties.Name="음성 인식 모델 검색" /><ComboBox x:Name="TranscriptionModelList" DisplayMemberPath="Label" SelectionChanged="CatalogSelection_Changed" Margin="0,5,0,5" AutomationProperties.Name="음성 인식 모델 목록" /><TextBox x:Name="TranscriptionModelBox" TextChanged="CatalogModelId_Changed" AutomationProperties.Name="음성 인식 모델 ID" />
     <TextBlock Text="전사 모델은 audio/transcriptions를 지원해야 합니다." Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,8,0,0" />
    </StackPanel></Border>
    <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,16"><StackPanel>
     <Grid x:Name="SyncSettingsHeading"><StackPanel Orientation="Horizontal"><c:AppleIcon Kind="link" Width="16" Height="16" Margin="0,0,7,0" /><TextBlock Text="동기화와 웹 공유" FontWeight="SemiBold" FontSize="13" /></StackPanel><Border Background="{DynamicResource SegmentSurface}" CornerRadius="9" Padding="7,2" HorizontalAlignment="Right"><TextBlock x:Name="SharingTokenStatus" Text="미설정" FontSize="10" Foreground="{DynamicResource Muted}" /></Border></Grid>
     <TextBlock Text="같은 라이브러리를 사용할 기기에 서버 주소와 접속 토큰을 입력합니다. 동기화를 실행하면 녹음·회의록·프로필·AI 설정이 이 서버로 전송됩니다. 웹 공유는 회의록에서 별도로 실행합니다." Foreground="{DynamicResource Muted}" LineHeight="19" FontSize="11" Margin="0,9,0,12" />
     <TextBlock Text="공유 서버 주소" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,0,0,5" /><TextBox x:Name="SharingUrlBox" AutomationProperties.Name="웹 공유 서버 주소" />
     <TextBlock Text="SYNC_TOKEN" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,13,0,5" /><PasswordBox x:Name="SharingTokenBox" AutomationProperties.Name="웹 공유 동기화 토큰" />
     <TextBlock x:Name="SharingTokenHint" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,8,0,12" />
     <CheckBox x:Name="DeleteSharingTokenBox" Content="저장된 웹 공유 토큰 삭제" />
     <CheckBox x:Name="AutomaticSyncBox" Content="기기 간 자동 동기화" Margin="0,14,0,8" AutomationProperties.Name="기기 간 자동 동기화" />
     <TextBlock Text="앱이 실행 중일 때 약 30초마다 확인합니다. 녹음·재생·AI 처리·설정 편집이 끝난 뒤 실행하고 연결 실패 시 재시도 간격을 늘립니다." FontSize="11" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" />
     <WrapPanel Margin="0,12,0,0"><Button x:Name="TestSyncButton" Content="연결 확인" Click="TestSync_Click" /><Button x:Name="CancelSyncTestButton" Content="중단" Click="CancelPreparation_Click" Margin="8,0,0,0" Visibility="Collapsed" /></WrapPanel>
     <TextBlock x:Name="SyncConnectionStatus" FontSize="11" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0" />
    </StackPanel></Border>
    <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,16"><StackPanel>
     <TextBlock Text="녹음과 백그라운드 실행" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,12" />
     <CheckBox x:Name="AutoGenerateBox" Content="녹음 완료 후 회의록 자동 생성" Margin="0,0,0,12" />
     <CheckBox x:Name="TranscriptCleanupBox" Content="회의록 작성 전 전사 자동 정리" Margin="0,0,0,8" /><TextBlock Text="원문을 보존하며, 정리에 실패하면 원문으로 작성합니다. 회의록과 같은 처리 방법·모델을 사용합니다." Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12" />
     <TextBlock Text="선택한 전사·요약 엔진을 사용합니다. 클라우드를 선택하면 오디오·전사문이 전송되고 요금이 발생할 수 있습니다." FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,0,0,12" />
     <CheckBox x:Name="KeepRunningBox" Content="창을 닫아도 트레이에서 계속 실행" Margin="0,0,0,12" />
     <CheckBox x:Name="GlobalShortcutsBox" Content="다른 앱에서도 전역 단축키 사용" Margin="0,0,0,8" />
     <TextBlock Text="Ctrl+Alt+Shift+N: 앱 열기 · R: 녹음 시작/완료 · P: 일시정지/재개. 트레이 메뉴의 종료를 누르면 녹음을 저장한 뒤 앱을 종료합니다." FontSize="11" Foreground="{DynamicResource Muted}" />
    </StackPanel></Border>
    <Border Style="{StaticResource SettingsCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="180" /></Grid.ColumnDefinitions><TextBlock Text="출력 언어" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" /><ComboBox Grid.Column="1" x:Name="LanguageBox" AutomationProperties.Name="회의록 출력 언어"><ComboBoxItem Content="한국어" /><ComboBoxItem Content="English" /><ComboBoxItem Content="원문 언어" /></ComboBox></Grid></Border>
    <TextBlock x:Name="ErrorText" Foreground="{DynamicResource RecordRed}" Margin="0,12,0,0" />
   </StackPanel>
  </ScrollViewer>
  <Border Grid.Row="2" BorderBrush="{DynamicResource Separator}" BorderThickness="0,1,0,0" Padding="24,14" Background="{DynamicResource ToolbarSurface}"><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="취소" IsCancel="True" MinWidth="70" Margin="0,0,8,0" /><Button x:Name="SaveSettingsButton" Content="저장" MinWidth="70" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Save_Click" /></StackPanel></Border>
 </Grid>
 </Border>
</Window>
