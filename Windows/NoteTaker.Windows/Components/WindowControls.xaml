<UserControl x:Class="NoteTaker.Windows.Components.WindowControls"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="82" Height="44">
 <UserControl.Resources><Style x:Key="Light" TargetType="Button">
  <Setter Property="Width" Value="22" /><Setter Property="Height" Value="24" /><Setter Property="MinHeight" Value="0" /><Setter Property="Padding" Value="0" /><Setter Property="FontSize" Value="11" />
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Grid><Ellipse Width="12" Height="12" Fill="{TemplateBinding Background}" Stroke="#20000000" StrokeThickness=".7" /><ContentPresenter x:Name="Symbol" Opacity="0" HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="#80000000" /></Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Symbol" Property="Opacity" Value="1" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".25" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
 </Style></UserControl.Resources>
 <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
  <Button Style="{StaticResource Light}" Background="#FF5F57" Content="×" Click="Close_Click" ToolTip="닫기" AutomationProperties.Name="닫기" />
  <Button x:Name="MinimizeButton" Style="{StaticResource Light}" Background="#FEBC2E" Content="−" Click="Minimize_Click" ToolTip="최소화" AutomationProperties.Name="최소화" />
  <Button x:Name="MaximizeButton" Style="{StaticResource Light}" Background="#28C840" Content="+" Click="Maximize_Click" ToolTip="최대화 / 복원" AutomationProperties.Name="최대화 또는 복원" />
 </StackPanel>
</UserControl>
