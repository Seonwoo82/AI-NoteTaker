<Window x:Class="NoteTaker.Windows.ProfileWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:c="clr-namespace:NoteTaker.Windows.Components" Title="나의 프로필" Width="720" Height="780" MinWidth="600" MinHeight="650"
 WindowStartupLocation="CenterOwner" ShowInTaskbar="False" WindowStyle="None" Style="{StaticResource {x:Type Window}}" Closing="Window_Closing">
 <WindowChrome.WindowChrome><WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="10" UseAeroCaptionButtons="False" /></WindowChrome.WindowChrome>
 <Border Background="{DynamicResource WindowSurface}" BorderBrush="{DynamicResource Separator}" BorderThickness="1" CornerRadius="10">
  <Grid><Grid.RowDefinitions><RowDefinition Height="44" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
   <Grid Background="{DynamicResource ToolbarSurface}"><c:WindowControls HorizontalAlignment="Left" WindowChrome.IsHitTestVisibleInChrome="True" /><TextBlock Text="나의 프로필" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Grid>
   <TabControl Grid.Row="1" x:Name="ProfileTabs" Margin="22,16,22,0">
    <TabItem Header="이름과 용어"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,14,0,12">
     <TextBlock Text="회의에서 사용하는 이름" FontSize="20" FontWeight="SemiBold" /><TextBlock Text="회의록을 정리할 때 이름과 용어를 참고합니다. 전사 원문은 그대로 보존됩니다." Foreground="{DynamicResource Muted}" Margin="0,6,0,16" />
     <Border Style="{StaticResource SettingsCard}"><StackPanel>
      <TextBlock Text="이름" Margin="0,0,0,5" /><TextBox x:Name="ProfileNameBox" MaxLength="120" AutomationProperties.Name="프로필 이름" />
      <TextBlock Text="별칭 · 쉼표로 구분" Margin="0,13,0,5" /><TextBox x:Name="ProfileAliasesBox" MaxLength="3000" AutomationProperties.Name="프로필 별칭" />
      <TextBlock Text="역할" Margin="0,13,0,5" /><TextBox x:Name="ProfileRoleBox" MaxLength="160" AutomationProperties.Name="프로필 역할" />
      <CheckBox x:Name="AutoAnalyzeBox" Content="녹음이 끝나면 참여자 자동 분석" Margin="0,16,0,0" />
     </StackPanel></Border>
     <TextBlock Text="자주 쓰는 용어" FontSize="16" FontWeight="SemiBold" Margin="0,18,0,7" /><TextBlock Text="회의에서 들리는 표현과 올바른 표기를 함께 입력하세요." Foreground="{DynamicResource Muted}" Margin="0,0,0,9" />
     <DataGrid x:Name="GlossaryGrid" Height="215" AutoGenerateColumns="False" CanUserAddRows="True" CanUserDeleteRows="True" HeadersVisibility="Column" RowHeaderWidth="0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource Separator}" BorderBrush="{DynamicResource Separator}" Background="{DynamicResource CardSurface}" RowBackground="{DynamicResource CardSurface}" AlternatingRowBackground="{DynamicResource WindowSurface}" Foreground="{DynamicResource Ink}" SelectionUnit="FullRow" AutomationProperties.Name="용어집">
      <DataGrid.Resources><Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="{DynamicResource ControlSurface}" /><Setter Property="Foreground" Value="{DynamicResource Ink}" /><Setter Property="Padding" Value="8" /><Setter Property="FontWeight" Value="SemiBold" /></Style><Style TargetType="DataGridCell"><Setter Property="Padding" Value="5" /><Setter Property="BorderThickness" Value="0" /></Style></DataGrid.Resources>
      <DataGrid.Columns><DataGridTextColumn Header="올바른 표기" Binding="{Binding Term, UpdateSourceTrigger=PropertyChanged}" Width="*" /><DataGridTextColumn Header="들리는 표현" Binding="{Binding SpokenAs, UpdateSourceTrigger=PropertyChanged}" Width="*" /><DataGridTextColumn Header="뜻 / 설명" Binding="{Binding Meaning, UpdateSourceTrigger=PropertyChanged}" Width="1.4*" /><DataGridComboBoxColumn x:Name="TermCategoryColumn" Header="종류" SelectedValueBinding="{Binding Category, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Id" DisplayMemberPath="Name" Width="90" /></DataGrid.Columns>
     </DataGrid>
     <Button Content="선택한 용어 삭제" Click="DeleteTerm_Click" HorizontalAlignment="Left" Margin="0,8,0,0" /><TextBlock Text="빈 마지막 행에서 새 용어를 추가할 수 있습니다. 최대 200개까지 저장합니다." FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,8,0,0" />
    </StackPanel></ScrollViewer></TabItem>
    <TabItem Header="내 목소리"><ScrollViewer x:Name="VoiceScroll" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,16,0,12">
     <TextBlock Text="내 목소리 알아보기" FontSize="20" FontWeight="SemiBold" /><TextBlock Text="녹음 중 내 발화를 표시하고, 회의에서 내 목소리를 찾습니다." Foreground="{DynamicResource Muted}" Margin="0,6,0,16" />
     <Border Style="{StaticResource SettingsCard}"><StackPanel>
      <TextBlock x:Name="VoiceProfileStatus" FontWeight="SemiBold" FontSize="15" /><TextBlock Text="조용한 곳에서 혼자 10~30초 동안 아래 문장을 읽어 주세요." Margin="0,10,0,12" />
      <Border Background="{DynamicResource AccentSoft}" Padding="16" CornerRadius="8"><TextBlock Text="안녕하세요. 앞으로 회의에서 제가 말한 내용을 쉽게 찾기 위해 목소리를 등록합니다. 오늘 회의의 목표와 주요 안건을 차근차근 살펴보고, 결정한 내용과 다음에 할 일을 함께 정리하겠습니다." FontSize="15" LineHeight="25" /></Border>
      <TextBlock x:Name="EnrollmentClock" Text="00:00 / 00:30" FontFamily="Consolas" FontSize="22" Margin="0,18,0,12" TextAlignment="Center" /><ProgressBar x:Name="EnrollmentLevel" Height="6" />
      <WrapPanel HorizontalAlignment="Center" Margin="0,18,0,0"><Button x:Name="StartEnrollmentButton" Content="목소리 녹음 시작" Style="{StaticResource PrimaryButton}" Click="StartEnrollment_Click" Margin="0,0,8,8" /><Button x:Name="FinishEnrollmentButton" Content="등록 완료" Click="FinishEnrollment_Click" IsEnabled="False" Margin="0,0,8,8" /><Button x:Name="CancelEnrollmentButton" Content="등록 취소" Click="CancelEnrollment_Click" IsEnabled="False" Margin="0,0,0,8" /></WrapPanel>
      <Button x:Name="DeleteVoiceButton" Content="목소리 프로필 삭제" Click="DeleteVoice_Click" Style="{StaticResource LinkButton}" Foreground="{DynamicResource RecordRed}" HorizontalAlignment="Center" />
     </StackPanel></Border>
     <TextBlock Text="등록용 녹음은 처리 후 삭제하고 목소리 특징만 이 PC에 보관합니다. 다른 기기로 동기화하지 않습니다. 재등록에 실패하면 기존 프로필을 유지합니다." Foreground="{DynamicResource Muted}" Margin="0,14,0,0" FontSize="11" />
     <TextBlock Text="목소리 등록·삭제는 완료 즉시 반영됩니다. 자동 구분 결과가 틀리면 참여자 화면에서 수정할 수 있습니다." Foreground="{DynamicResource Muted}" Margin="0,10,0,0" FontSize="11" />
    </StackPanel></ScrollViewer></TabItem>
   </TabControl>
   <Border Grid.Row="2" BorderBrush="{DynamicResource Separator}" BorderThickness="0,1,0,0" Padding="22,12"><StackPanel><TextBlock x:Name="ProfileStatus" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10" /><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="CloseProfileButton" Content="닫기" Click="CloseProfile_Click" Margin="0,0,8,0" /><Button x:Name="SaveProfileButton" Content="이름과 용어 저장" Style="{StaticResource PrimaryButton}" Click="SaveProfile_Click" /></StackPanel></StackPanel></Border>
  </Grid>
 </Border>
</Window>
