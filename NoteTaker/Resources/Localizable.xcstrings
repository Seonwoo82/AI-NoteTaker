  "strings" : {
    "Save Key & Enable AI" : {
      "extractionState" : "manual",
      "localizations" : { "ko" : { "stringUnit" : { "state" : "translated", "value" : "키 저장 및 자동 회의록 켜기" } } }
    },
    "Save Key & Enable AI turns on automatic minutes for new recordings. You can turn it off below." : {
      "extractionState" : "manual",
      "localizations" : { "ko" : { "stringUnit" : { "state" : "translated", "value" : "아래 '키 저장 및 자동 회의록 켜기'를 누르면 새 녹음부터 자동 생성합니다. 자동 생성은 언제든 끌 수 있습니다." } } }
    },
    "AI Meeting Notes" : {
      "extractionState" : "manual",
      "localizations" : { "ko" : { "stringUnit" : { "state" : "translated", "value" : "AI 회의록" } } }
    },
    "Configure OpenRouter transcription and minutes generation." : {
