{
  "sourceLanguage": "en",
  "strings": {
    "Recordings, AI minutes, and completed transcripts sync between devices. Set your OpenRouter API key separately on each device.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음성 녹음, AI 회의록과 완성된 전사문을 기기 간 동기화합니다. OpenRouter API 키는 각 기기에 별도로 설정하세요."
          }
        }
      }
    },
    "The existing minutes remain available while this runs. Keep this app open until generation finishes.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "생성 중에도 기존 회의록을 볼 수 있습니다. 완료될 때까지 앱을 열어두세요."
          }
        }
      }
    },
    "Loading waveform...": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파형을 불러오는 중…"
          }
        }
      }
    },
    "Waveform unavailable": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파형을 불러오지 못했습니다"
          }
        }
      }
    },
    "Reload Waveform": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파형 다시 불러오기"
          }
        }
      }
    },
    "Save Key & Enable AI": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키 저장 및 자동 회의록 켜기"
          }
        }
      }
    },
    "Save Key & Enable AI turns on automatic minutes for new recordings. You can turn it off below.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아래 '키 저장 및 자동 회의록 켜기'를 누르면 새 녹음부터 자동 생성합니다. 자동 생성은 언제든 끌 수 있습니다."
          }
        }
      }
    },
    "AI Meeting Notes": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 회의록"
          }
        }
      }
    },
    "Configure OpenRouter transcription and minutes generation.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenRouter 음성 인식과 회의록 생성을 설정합니다."
          }
        }
      }
    },
    "Before you save an API key": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "API 키를 저장하기 전에"
          }
        }
      }
    },
    "When AI minutes are generated, your recording audio and transcript are sent to OpenRouter and the selected model providers. Provider usage may be billed to your OpenRouter account.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 회의록을 생성하면 녹음 오디오와 전사문이 OpenRouter 및 선택한 모델 제공자에게 전송됩니다. 사용량에 따라 OpenRouter 계정에 요금이 부과될 수 있습니다."
          }
        }
      }
    },
    "OpenRouter API Key": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenRouter API 키"
