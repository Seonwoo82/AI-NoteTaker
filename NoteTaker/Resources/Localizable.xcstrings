    },
    "Sync Now": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 동기화"
          }
        }
      }
    },
    "Sync runs when you open the app, save changes, or choose Sync Now. If both devices edit the same note, the edit with the later device timestamp wins. Keep device clocks set automatically.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱을 열거나 변경 사항을 저장하거나 지금 동기화를 누르면 동기화합니다. 같은 노트를 두 기기에서 수정하면 기기 시간 기준으로 나중에 수정한 내용이 적용됩니다. 기기의 날짜와 시간을 자동 설정으로 유지하세요."
          }
        }
      }
    },
    "Syncing…": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동기화 중…"
          }
        }
      }
    },
    "Test Connection": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결 테스트"
          }
        }
      }
    },
    "The Worker uses D1 for note information and R2 for audio. Set up these resources with the deployment guide included in this project.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Worker는 노트 정보를 D1에, 음성 파일을 R2에 저장합니다. 프로젝트에 포함된 배포 안내에 따라 리소스를 설정하세요."
          }
        }
      }
    },
    "This recording is in Recently Deleted. Restore it to listen again.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최근 삭제된 녹음입니다. 복원하면 다시 들을 수 있습니다."
          }
        }
      }
    },
    "Try a different title.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 제목으로 검색해 보세요."
          }
        }
      }
    },
    "Unable to Complete Action": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업을 완료할 수 없습니다"
          }
        }
      }
    },
    "Use the same Cloudflare server and sync key on your Mac and iPhone. Your recordings stay available offline.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac과 iPhone에 같은 Cloudflare 서버와 동기화 키를 입력하세요. 오프라인에서도 저장된 녹음을 들을 수 있습니다."
          }
        }
      }
    },
    "Voice Notes": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음성 노트"
          }
        }
      }
    },
    "Your ideas, ready to listen to.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록한 생각을 다시 들어보세요."
          }
        }
      }
    },
    "Remove Recording from This Mac?": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac에서 녹음 제거?"
          }
        }
      }
    },
    "Remove from This Mac": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac에서 제거"
          }
        }
      }
    },
    "This removes this Mac's audio and AI files. Sync metadata stays so other devices keep the cloud deletion state.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac의 오디오와 AI 파일을 제거합니다. 다른 기기에서도 클라우드 삭제 상태가 유지되도록 동기화 메타데이터는 남겨 둡니다."
          }
        }
      }
    },
    "Only recently deleted recordings can be removed from this Mac.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최근 삭제된 녹음만 이 Mac에서 제거할 수 있습니다."
          }
        }
      }
    },
    "The recording could not be removed from this Mac. Its local files were preserved.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹음을 이 Mac에서 제거하지 못했습니다. 로컬 파일은 보존되었습니다."
          }
        }
      }
    },
